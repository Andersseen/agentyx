{
  "name": "agentyx",
  "version": "0.0.0",
  "description": "Provider-agnostic tooling for coding agents.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agentyx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agentyx.git"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agentyx/issues"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agentyx": "node packages/cli/dist/index.mjs",
    "build": "pnpm -r --sort run build",
    "changeset": "changeset",
    "check": "biome check . && pnpm report:check && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r --parallel run clean",
    "dev": "pnpm --filter @agentyx/web dev",
    "eval:skills": "pnpm --filter @agentyx/core run build && node scripts/evaluate-skills.mjs",
    "eval:behavior": "pnpm --filter @agentyx/core run build && node scripts/evaluate-behavior.mjs validate",
    "e2e:web": "pnpm --filter @agentyx/web e2e",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "release": "pnpm check && pnpm smoke:pack && changeset publish",
    "report:check": "pnpm --filter @agentyx/cli run report:check",
    "report:generate": "pnpm --filter @agentyx/cli run report:generate",
    "smoke:pack": "node packages/cli/scripts/pack-smoke.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.3",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0"
  },
  "pnpm": {
    "overrides": {
      "@angular/cdk": "21.2.14"
    }
  }
}
