{
  "name": "agnox",
  "version": "0.0.0",
  "description": "Provider-agnostic tooling for coding agents.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agnox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agnox.git"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agnox/issues"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agnox": "node packages/cli/dist/index.mjs",
    "build": "pnpm -r --sort run build",
    "changeset": "changeset",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r --parallel run clean",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "release": "pnpm build && changeset publish",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
