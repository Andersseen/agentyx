{
  "name": "@agnox/core",
  "version": "0.0.0",
  "description": "Shared domain foundations for Agnox.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema/agnox.schema.json": "./schema/agnox.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean",
    "clean": "rm -rf dist",
    "schema": "node scripts/generate-schema.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.0.17"
  }
}
