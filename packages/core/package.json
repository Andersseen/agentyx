{
  "name": "@agnox/core",
  "version": "0.0.0",
  "description": "Shared domain foundations for Agnox: configuration model and stack resolution.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agnox/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agnox.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agnox/issues"
  },
  "keywords": [
    "agnox",
    "coding-agents",
    "configuration",
    "developer-tools",
    "stacks"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema/agnox.schema.json": "./schema/agnox.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean",
    "clean": "rm -rf dist",
    "schema": "node scripts/generate-schema.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.0.17"
  }
}
