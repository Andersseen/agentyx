{
  "name": "@agentyx/core",
  "version": "0.1.1",
  "description": "Shared domain foundations for Agentyx: configuration model, stack resolution and skills.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agentyx/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agentyx.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agentyx/issues"
  },
  "keywords": [
    "agentyx",
    "coding-agents",
    "configuration",
    "developer-tools",
    "skills",
    "stacks"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./schema/agentyx.schema.json": "./schema/agentyx.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean",
    "clean": "rm -rf dist",
    "schema": "node scripts/generate-schema.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.0.17"
  }
}
