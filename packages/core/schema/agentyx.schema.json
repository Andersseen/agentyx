{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Andersseen/agentyx/main/packages/core/schema/agentyx.schema.json",
  "title": "Agentyx project configuration",
  "description": "Configuration for an Agentyx project (.agentyx.json).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path or URL to the Agentyx JSON Schema."
    },
    "packs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Capability packs this project selects."
    },
    "enable": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Optional capabilities to activate by explicit identifier."
    },
    "targets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Coding-agent providers this project targets."
    },
    "skillDirectories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\\\0]+$"
      },
      "description": "Project-relative roots containing local Agent Skills."
    },
    "localPacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Unique pack identifier."
          },
          "category": {
            "default": "engineering",
            "type": "string",
            "enum": ["engineering", "language", "framework", "efficiency", "workflow"],
            "description": "Discoverability category; does not affect resolution."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Short human-readable summary of the pack."
          },
          "skills": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Skills this pack contributes, in declaration order."
          },
          "mcpServers": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "MCP server identifier."
                    },
                    "activation": {
                      "default": "default",
                      "type": "string",
                      "enum": ["default", "optional"],
                      "description": "Whether this MCP capability is active by default or explicit opt-in."
                    }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                }
              ]
            },
            "description": "MCP servers this pack contributes, in declaration order."
          },
          "tools": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Tool identifier."
                    },
                    "activation": {
                      "default": "default",
                      "type": "string",
                      "enum": ["default", "optional"]
                    }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Local tools this pack contributes, in declaration order."
          },
          "hooks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "description": "Hook identifier."
                    },
                    "activation": {
                      "default": "default",
                      "type": "string",
                      "enum": ["default", "optional"]
                    }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Provider lifecycle hooks this pack contributes, in declaration order."
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "description": "Project-owned packs that can reference built-in or local Skills."
    },
    "trustedSources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Known trusted source identifier."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\\\0]+$",
            "description": "Project-relative checkout path for this source."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Reviewed immutable commit, signed tag or pinned release identifier."
          }
        },
        "required": ["name", "path", "ref"],
        "additionalProperties": false
      },
      "description": "Pinned local checkouts of known external skill/plugin sources."
    },
    "project": {
      "description": "Identity and ownership for this project.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable, human-authored project identifier in kebab-case."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable project name."
        },
        "description": {
          "description": "Short description of this project.",
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "description": "Repository URL; descriptive and never fetched.",
          "type": "string",
          "format": "uri"
        },
        "docs": {
          "default": [],
          "description": "Documentation URLs; descriptive only.",
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "mcp": {
          "default": [],
          "description": "MCP server identifiers available to consult.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owns": {
          "default": [],
          "description": "Architectural capabilities owned by this project.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "relations": {
      "description": "Direct architectural relationships.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stable identifier for the related project."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable related project name."
          },
          "type": {
            "type": "string",
            "enum": ["uses", "integrates", "consumes", "extends"],
            "description": "How the current project relates to this project."
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Architectural role of the related project."
          },
          "repository": {
            "description": "Repository URL; descriptive and never fetched.",
            "type": "string",
            "format": "uri"
          },
          "docs": {
            "default": [],
            "description": "Documentation URLs; descriptive only.",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "mcp": {
            "default": [],
            "description": "MCP server identifiers available to consult.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owns": {
            "default": [],
            "description": "Architectural capabilities owned by this project.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "guidance": {
            "default": [],
            "description": "Human-authored guidance for agents.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["id", "name", "type", "role"],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "commands": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Suggested command; Agentyx never executes it."
              },
              "cwd": {
                "default": ".",
                "description": "Project-relative working directory.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["command"],
            "additionalProperties": false
          }
        },
        "areas": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path", "purpose"],
            "additionalProperties": false
          }
        },
        "constraints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "description": "Explicit repository-local facts for the generated project context Skill."
    }
  },
  "additionalProperties": false
}
