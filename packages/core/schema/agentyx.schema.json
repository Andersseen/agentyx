{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentyx.dev/schema/agentyx.schema.json",
  "title": "Agentyx project configuration",
  "description": "Configuration for an Agentyx project (.agentyx.json).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path or URL to the Agentyx JSON Schema."
    },
    "packs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Capability packs this project selects."
    },
    "enable": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Optional capabilities to activate by explicit identifier."
    },
    "targets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Coding-agent providers this project targets."
    }
  },
  "additionalProperties": false
}
