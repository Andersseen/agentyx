{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentyx.dev/schema/agentyx.schema.json",
  "title": "Agentyx project configuration",
  "description": "Configuration for an Agentyx project (.agentyx.json).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path or URL to the Agentyx JSON Schema."
    },
    "extends": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Stacks this project builds on."
    },
    "profile": {
      "default": "balanced",
      "type": "string",
      "enum": ["lean", "balanced", "autonomous"],
      "description": "How much autonomy the generated environment grants."
    },
    "targets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Coding-agent providers this project targets."
    }
  },
  "additionalProperties": false
}
