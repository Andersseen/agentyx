{
  "name": "@agnox/cli",
  "version": "0.0.0",
  "description": "Command-line interface for Agnox.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agnox/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agnox.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agnox/issues"
  },
  "keywords": [
    "agnox",
    "cli",
    "coding-agents",
    "developer-tools"
  ],
  "bin": {
    "agnox": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "agnox": "node dist/index.mjs",
    "build": "tsdown src/index.ts --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agnox/adapters": "workspace:*",
    "@agnox/core": "workspace:*",
    "@clack/prompts": "^0.11.0",
    "commander": "^15.0.0",
    "zod": "^4.0.17"
  }
}
