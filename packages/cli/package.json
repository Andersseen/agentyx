{
  "name": "@agentyx/cli",
  "version": "0.21.0",
  "description": "Command-line interface for Agentyx.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agentyx/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agentyx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agentyx/issues"
  },
  "keywords": [
    "agentyx",
    "cli",
    "coding-agents",
    "developer-tools"
  ],
  "bin": {
    "agentyx": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "agentyx": "node dist/index.mjs",
    "build": "tsdown src/index.ts --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report:generate": "node scripts/generate-report-renderer.mjs",
    "report:check": "node scripts/generate-report-renderer.mjs --check"
  },
  "dependencies": {
    "@agentyx/adapters": "workspace:*",
    "@agentyx/core": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@flowview/runtime": "0.2.0",
    "commander": "^14.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@flowview/compiler": "0.2.3"
  }
}
