{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install agentyx hook observe --provider codex",
            "statusMessage": "agentyx:observe-tool-use",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install agentyx hook observe --provider codex",
            "statusMessage": "agentyx:observe-session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install agentyx doctor --hook",
            "statusMessage": "agentyx:session-doctor-bootstrap"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install agentyx hook observe --provider codex",
            "statusMessage": "agentyx:observe-session-start",
            "async": true
          }
        ]
      }
    ]
  }
}
