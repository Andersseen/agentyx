{
  "name": "@agentyx/adapters",
  "version": "0.3.0",
  "description": "Provider adapters, MCP rendering and safe install planning for Agentyx.",
  "type": "module",
  "license": "MIT",
  "author": "Andersseen",
  "homepage": "https://github.com/Andersseen/agentyx/tree/main/packages/adapters#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/agentyx.git",
    "directory": "packages/adapters"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/agentyx/issues"
  },
  "keywords": [
    "agentyx",
    "adapters",
    "coding-agents"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agentyx/core": "workspace:*",
    "@iarna/toml": "^2.2.5"
  }
}
